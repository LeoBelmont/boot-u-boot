config VIDEO_SYNA
	bool "Enable Syna Display support"
	depends on ARCH_SYNAPTICS
	depends on VIDEO
	help
	  This enables support for Synaptics display for
	  Edge Soc family

config PANEL_CFG
	string "Panel Config file"
	depends on VIDEO_SYNA
	help
		Configures the panel information from Header file provided.

config SYNA_DRM_BRIDGE_LT9611
	bool "Syna driver based LT9611 bridge"
	select VIDEO_BRIDGE
	depends on VIDEO_SYNA
	help
	  Enable this option to configures Syna driver based
	  LT9611 bridge support

config SYNA_WSPANEL_1080P
	bool "syna compatible wspanel 1080p resolution"
	depends on VIDEO_SYNA
	help
	  Enable this option to the syna compatible waveshare 13.3 inch panel with
	  1080p resolution

config DEFAULT_PANEL_DTBO
	string "Panel default dtbo file"
	depends on VIDEO_SYNA
	help
		Configures the default panel dtbo to be applied.

config PANEL_DTBO_PATH
	string "Rootfs path to dtbo file"
	depends on VIDEO_SYNA
	help
		Configures the rootfs path to find panel dtbo.

config SYNA_DISABLE_BOOTLOGO
	bool "Disable logo display from uboot and kernel"
	default n
	help
	  Disable logo display in both uboot and kernel.
	  Use this macro to disable logo in a production or usb
	  image, where logo is not available because of missing
	  eMMC/fastlogo.subimg. But display testing is rebuild
	  only after linux bootup.

config SYNA_DISABLE_FBCON
	bool "Disable FBCON in kernel"
	default n
	help
	  Disable FBCON in kernel. When enabled, the kernel will
	  not attach a text console to the fbdev, which prevent
	  console output from appearing on display during boot
	  and runtime. Enable if display pipeline is managed
	  exclusively by userspace(wayland/drm application).
	  Disable for head-less environment without serial console.

